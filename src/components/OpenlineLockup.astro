---
// The Openline lockup as openline/assets/brand/README.md sets it: the mark
// (openline-mark.svg, cropped to its squares) as tall as the capitals, 0.43 of
// its height from "Openline" in Geist Medium. Don't redraw or recolor it.
const label = "Openline";
---

<span class="lockup">
  <svg
    aria-hidden="true"
    fill="#8C1D2F"
    viewBox="18 8 233 240"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect x="84.114" y="13.897" width="17.554" height="17.554" />
    <rect x="148.539" y="8.104" width="29.140" height="29.140" />
    <rect x="49.006" y="49.006" width="17.554" height="17.554" />
    <rect x="180.663" y="40.229" width="35.109" height="35.109" />
    <rect x="18.286" y="88.503" width="8.777" height="8.777" />
    <rect x="215.771" y="75.337" width="35.109" height="35.109" />
    <rect x="53.394" y="123.611" width="8.777" height="8.777" />
    <rect x="180.663" y="110.446" width="35.109" height="35.109" />
    <rect x="18.286" y="158.720" width="8.777" height="8.777" />
    <rect x="215.771" y="145.554" width="35.109" height="35.109" />
    <rect x="49.006" y="189.440" width="17.554" height="17.554" />
    <rect x="180.663" y="180.663" width="35.109" height="35.109" />
    <rect x="84.114" y="224.549" width="17.554" height="17.554" />
    <rect x="148.539" y="218.756" width="29.140" height="29.140" />
  </svg>
  <span class="word">{label}</span>
</span>

<style>
  .lockup {
    display: inline-flex;
    align-items: center;
    font-family: "Geist Variable", sans-serif;
    font-size: 2.25rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  /* Geist's cap height is about 0.71 em. */
  svg {
    display: block;
    width: auto;
    height: 0.71em;
    margin-right: calc(0.71em * 0.43);
  }

  .word {
    transition: color 0.15s;
  }
</style>
