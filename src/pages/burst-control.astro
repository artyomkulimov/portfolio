---
import { getImage, Image } from "astro:assets";
import appShot from "../assets/burst-control/app.png";
import appIcon from "../assets/burst-control/icon.png";
import BaseLayout from "../layouts/BaseLayout.astro";

// Update with each release.
const version = "0.2.0";
const released = "2026-11-02";
const firstReleased = "2026-10-23";

const repo = "https://github.com/artyomkulimov/burstcontrol";
const download = `${repo}/releases/latest`;
const walkthrough = `${repo}/blob/main/docs/reverse-engineering.md`;
const site = Astro.site ?? Astro.url.origin;
const pageUrl = new URL("/burst-control", site).toString();

const title = "Burst Control: Turtle Beach Burst II Air software for Mac";
const description =
  "Free, open-source Mac app for the Turtle Beach Burst II Air (Burst 2 Air) mouse. Change DPI, polling rate, debounce, lift-off distance and motion sync, and see battery level on macOS, over the 2.4 GHz receiver or USB cable.";

const shot = await getImage({ src: appShot, width: 1200, format: "png" });

const settings = [
  {
    name: "DPI",
    body: "All five DPI stages, from 50 to 26,000 DPI in steps of 50. The stage you're on is highlighted as you press the mouse's DPI button.",
  },
  {
    name: "Polling rate",
    body: "125, 250, 500 or 1,000 Hz.",
  },
  {
    name: "Debounce",
    body: "0 to 10 ms.",
  },
  {
    name: "Tracking",
    body: "Lift-off distance, angle snapping and motion sync.",
  },
  {
    name: "Battery",
    body: "Battery percentage, charging state and whether the mouse is on the receiver or the cable.",
  },
  {
    name: "Safe writes",
    body: "Changes stay a draft until you click Apply. The app backs up the current settings before writing and reads them back afterwards to check they were stored.",
  },
];

const compatibility = [
  {
    connection: "USB cable",
    id: "10f5:5002",
    status: "Supported",
  },
  {
    connection: "2.4 GHz receiver",
    id: "10f5:5004",
    status: "Supported (battery over the receiver not yet confirmed)",
  },
  {
    connection: "Bluetooth",
    id: "–",
    status: "Not supported",
  },
];

const faq = [
  {
    q: "Is there Turtle Beach Burst II Air software for Mac?",
    a: "Yes. Burst Control is a free, open-source Mac app for the Burst II Air (also written Burst 2 Air). It changes the mouse's DPI stages, polling rate, debounce, lift-off distance, angle snapping and motion sync, and shows its battery level, without a Windows PC.",
  },
  {
    q: "Can I install it with Homebrew?",
    a: "Yes: brew install --cask artyomkulimov/tap/burst-control. Homebrew downloads the same signed and notarized release as the GitHub download.",
  },
  {
    q: "How do I change the DPI of the Burst II Air on a Mac?",
    a: "Install Burst Control, allow it under Input Monitoring, then plug in the mouse or its receiver. Click any of the five DPI numbers, type a value between 50 and 26,000, and click Apply.",
  },
  {
    q: "Do I still need Swarm II?",
    a: "Not for the settings listed here. Swarm II is Turtle Beach's own configuration software. Burst Control speaks the same USB protocol from macOS, so you don't need a Windows PC or a virtual machine to change them.",
  },
  {
    q: "Does it work wirelessly?",
    a: "Yes, through the 2.4 GHz USB receiver as well as the USB cable. When both are connected, the cable is used. Bluetooth is not supported.",
  },
  {
    q: "Which Macs does it run on?",
    a: "macOS 13 Ventura or later. The signed release is built for Apple silicon (M1 and newer); there is no Intel build yet.",
  },
  {
    q: "Why does it ask for Input Monitoring?",
    a: "On this mouse the settings channel shares a USB interface with mouse input, so macOS only opens it to apps with Input Monitoring. Burst Control doesn't record movement or keystrokes and doesn't generate input.",
  },
  {
    q: "Do I need to keep the app running?",
    a: "No. Settings are written to the mouse's active onboard profile, so you can quit the app after clicking Apply. There is no background helper.",
  },
  {
    q: "Is it safe? Is it official?",
    a: "It's an independent project, not made or endorsed by Turtle Beach. It never flashes firmware, keeps settings it doesn't understand as they are, and backs up your current settings before every write.",
  },
  {
    q: "What can't it do yet?",
    a: "Switching onboard profiles, button remapping, macros, surface calibration and sleep settings. Bug reports and hardware reports are welcome on GitHub.",
  },
];

const author = {
  "@type": "Person",
  name: "Artyom Kulimov",
  url: new URL("/", site).toString(),
  sameAs: ["https://github.com/artyomkulimov", "https://x.com/artyomkulimov"],
};

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Burst Control",
    alternateName: [
      "BurstControl",
      "Turtle Beach Burst II Air Mac software",
      "Burst 2 Air Mac app",
    ],
    description,
    url: pageUrl,
    image: new URL(shot.src, site).toString(),
    screenshot: new URL(shot.src, site).toString(),
    applicationCategory: "UtilitiesApplication",
    applicationSubCategory: "Mouse configuration",
    operatingSystem: "macOS 13 or later (Apple silicon)",
    softwareVersion: version,
    datePublished: firstReleased,
    dateModified: released,
    downloadUrl: download,
    installUrl: download,
    license: "https://opensource.org/license/mit",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    author,
    sameAs: [repo],
    about: {
      "@type": "Product",
      name: "Turtle Beach Burst II Air",
      alternateName: "Burst 2 Air",
      brand: { "@type": "Brand", name: "Turtle Beach" },
      category: "Wireless gaming mouse",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: "Burst Control",
    codeRepository: repo,
    programmingLanguage: "Swift",
    runtimePlatform: "macOS",
    license: "https://opensource.org/license/mit",
    author,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map(({ q, a }) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "artyom",
        item: new URL("/", site).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Burst Control",
        item: pageUrl,
      },
    ],
  },
];
---

<BaseLayout
  description={description}
  exactTitle
  jsonLd={jsonLd}
  ogImage="/burst-control/og.png"
  ogImageAlt="Burst Control, Turtle Beach Burst II Air software for Mac, showing DPI stages, debounce, polling rate and battery"
  title={title}
>
  <header class="hero">
    <p class="subtle">free mac app · open source</p>
    <h1 class="title lockup">
      <Image alt="" class="icon" loading="eager" src={appIcon} width={96} />
      Burst Control
    </h1>
    <p class="ink lede">Turtle Beach Burst II Air software for Mac.</p>
    <p class="dim">
      Change the DPI, polling rate, debounce and tracking settings of the Burst
      II Air (also sold as Burst 2 Air) on macOS, and see its battery level. It
      talks to the mouse directly over the 2.4 GHz receiver or the USB cable. No
      Windows PC or virtual machine needed.
    </p>
    <p class="pills">
      <a class="pill" href={download}>download for mac ↗</a>
      <a class="pill" href={repo}>source on github ↗</a>
    </p>
    <p class="subtle small">
      v{version}
      · macOS 13+ · Apple silicon · signed and notarized by Apple · MIT license
    </p>
    <figure>
      <Image
        alt="Burst Control on macOS showing a Burst II Air at 85% battery on USB cable: five DPI stages (400, 800, 1000, 1600, 3200) with 1000 active, debounce 0 ms, polling rate 500 Hz, lift-off distance very low, angle snapping off and motion sync on"
        class="shot"
        loading="eager"
        sizes="(min-width: 640px) 600px, 92vw"
        src={appShot}
        widths={[600, 900, 1200]}
      />
      <figcaption>
        Burst Control with a Burst II Air connected by cable.
      </figcaption>
    </figure>
  </header>

  <section aria-labelledby="settings">
    <h2 id="settings">What you can change</h2>
    <dl class="ruled">
      {settings.map((s) => (
        <div class="setting">
          <dt class="ink">{s.name}</dt>
          <dd class="dim">{s.body}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section aria-labelledby="install">
    <h2 id="install">Install</h2>
    <p class="dim">With Homebrew:</p>
    <pre
      class="code"
    ><code>brew install --cask artyomkulimov/tap/burst-control</code></pre>
    <p class="dim">Or by hand:</p>
    <ol class="steps dim">
      <li>
        Download the <code class="ink">.zip</code> from the
        <a class="text-link" href={download}>latest release on GitHub</a>, unzip
        it and move Burst Control to Applications.
      </li>
      <li>
        Open it, then turn it on under System Settings → Privacy & Security →
        Input Monitoring, and reopen the app.
      </li>
      <li>
        Plug in the USB cable, or connect the receiver and switch the mouse to
        2.4 GHz. The settings load automatically.
      </li>
    </ol>
    <p class="dim">
      To build from source you need macOS 13 or later and Apple's Command Line
      Tools; the steps are in the
      <a class="text-link" href={`${repo}#install-from-source`}>README</a>.
    </p>
  </section>

  <section aria-labelledby="compatibility">
    <h2 id="compatibility">Compatibility</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Connection</th>
            <th scope="col">USB ID</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          {compatibility.map((c) => (
            <tr>
              <td class="ink">{c.connection}</td>
              <td>{c.id}</td>
              <td>{c.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="dim">
      Tested on an Apple silicon Mac. It configures the mouse's active onboard
      profile and supports one mouse per connection type.
    </p>
  </section>

  <section aria-labelledby="how">
    <h2 id="how">How it works</h2>
    <p class="dim">
      The mouse stores its own settings; on Windows, Turtle Beach's Swarm II
      software sends the USB commands that change them. I took the Burst II Air
      module from Swarm II (<code class="ink">BURST_II_AIR.dll</code>), read its
      machine code to find each setting's handler and the commands it sends,
      then rebuilt the protocol with macOS HID feature reports in Swift and
      checked every mapping on the real mouse. The firmware is never modified.
    </p>
    <p class="dim">
      The full write-up covers device discovery, the 64-byte packet format and
      checksum, the settings blocks, battery fields and the differences between
      cable and receiver:
      <a class="text-link" href={walkthrough}
        >reverse-engineering walkthrough</a
      >.
    </p>
  </section>

  <section aria-labelledby="faq">
    <h2 id="faq">FAQ</h2>
    <div class="ruled">
      {faq.map(({ q, a }) => (
        <div class="qa">
          <h3>{q}</h3>
          <p class="dim">{a}</p>
        </div>
      ))}
    </div>
  </section>

  <p class="subtle small note">
    Burst Control is made by
    <a class="text-link" href="/">Artyom Kulimov</a>. It is an independent
    project, not affiliated with or endorsed by Turtle Beach. Released under the
    MIT license. Last updated <time datetime={released}>{released}</time>.
  </p>
</BaseLayout>

<style>
  .hero > * + * {
    margin-top: 1.25rem;
  }

  .hero > .lede {
    margin-top: 0.75rem;
  }

  .lockup {
    display: flex;
    gap: 0.875rem;
    align-items: center;
  }

  .lockup :global(.icon) {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.625rem;
  }

  .hero figure {
    margin-top: 2rem;
  }

  .small {
    font-size: 13px;
  }

  .setting {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1.5rem;
  }

  dd {
    margin: 0;
  }

  .steps {
    padding-left: 1.5rem;
    margin-bottom: 0;
  }

  .steps li + li {
    margin-top: 0.5rem;
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    font-size: 14px;
    color: var(--muted);
    text-align: left;
    border-collapse: collapse;
  }

  th {
    padding: 0.5rem 1rem 0.5rem 0;
    font-weight: 500;
    color: var(--subtle);
    border-bottom: 1px solid var(--border);
  }

  td {
    padding: 0.625rem 1rem 0.625rem 0;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
  }

  td:nth-child(2) {
    white-space: nowrap;
  }

  .qa h3 {
    margin: 0;
    font-size: inherit;
    font-weight: 500;
  }

  .qa p {
    margin-top: 0.375rem;
  }

  .note {
    margin-top: 4rem;
  }

  @media (max-width: 40rem) {
    .setting {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
