---
import { Image } from "astro:assets";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import babylon from "../assets/art/fall-of-babylon.jpg";
import pandemonium from "../assets/art/pandemonium.jpg";
import wetMoon from "../assets/art/wet-moon-putney-road.jpg";
import EmailCopy from "../components/EmailCopy.astro";
import PaletteToggle from "../components/PaletteToggle.astro";
import ProjectItem from "../components/ProjectItem.astro";
import SkillTags from "../components/SkillTags.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const paintings = [
  { src: pandemonium, alt: "pandemonium, john martin, 1841" },
  { src: babylon, alt: "the fall of babylon, john martin, 1819" },
  {
    src: wetMoon,
    alt: "a wet moon, putney road, john atkinson grimshaw, 1886",
  },
];
---

<BaseLayout>
  <section class="relative z-10">
    <div
      class="mb-12 flex flex-col sm:flex-row sm:items-start sm:justify-between"
    >
      <div>
        <h1
          class="mb-2 text-4xl font-semibold tracking-tighter text-neutral-700 dark:text-neutral-300"
        >
          artyom kulimov
        </h1>
        <div
          aria-label="site appearance"
          class="mt-3 flex flex-wrap items-center gap-x-2 font-mono text-[15px] leading-6 text-neutral-500 dark:text-neutral-400"
        >
          <PaletteToggle />
          <span
            aria-hidden="true"
            class="text-neutral-300 dark:text-neutral-700"
          >
            /
          </span>
          <ThemeToggle />
        </div>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:mt-0">
        <a
          href="https://github.com/artyomkulimov"
          aria-label="artyom kulimov github profile"
          class="inline-flex min-h-6 items-center text-neutral-600 transition-colors hover:text-neutral-800 dark:text-neutral-400 dark:hover:text-neutral-200"
        >
          github
        </a>
        <EmailCopy />
        <a
          href="https://www.linkedin.com/in/artyom-kulimov-7a5032265/"
          class="inline-flex min-h-6 items-center text-neutral-600 transition-colors hover:text-neutral-800 dark:text-neutral-400 dark:hover:text-neutral-200"
        >
          linkedin
        </a>
        <a
          href="https://x.com/artyomkulimov"
          class="inline-flex min-h-6 items-center text-neutral-600 transition-colors hover:text-neutral-800 dark:text-neutral-400 dark:hover:text-neutral-200"
        >
          x
        </a>
      </div>
    </div>

    <div class="relative mb-16">
      <div
        class="absolute left-0 top-0 h-px w-8 bg-neutral-300 dark:bg-neutral-600"
      ></div>
      <h2
        class="mb-8 text-lg font-medium text-neutral-800 dark:text-neutral-200"
      >
        now
      </h2>

      <ProjectItem
        ariaLabel="open openline.sh"
        href="https://openline.sh"
        showcase
      >
        <div class="mb-2 flex items-start justify-between gap-4">
          <h3
            class="font-medium text-neutral-800 transition-colors group-hover:text-neutral-950 dark:text-neutral-200 dark:group-hover:text-white"
          >
            openline
          </h3>
          <span
            class="project-showcase-link mt-0.5 inline-flex shrink-0 items-center gap-1.5 font-mono text-[13px] leading-6 text-neutral-600 dark:text-neutral-400"
          >
            openline.sh
            <span aria-hidden="true" class="inline-flex" data-showcase-arrow>
              <ArrowUpRight class="h-4 w-4" />
            </span>
          </span>
        </div>
        <p
          class="mb-2 text-sm font-medium text-neutral-800 dark:text-neutral-200"
        >
          currently fixing communication.
        </p>
        <p
          class="text-sm leading-relaxed text-neutral-700 dark:text-neutral-300"
        >
          lets your ai agent ask your teammates' agents directly instead of you
          copy-pasting between them. go cli + mcp on the client, typescript and
          effect on cloudflare workers behind it, drizzle and workos.
        </p>
        <SkillTags
          skills={[
            'go',
            'cloudflare workers',
            'effect',
            'mcp',
          ]}
        />
      </ProjectItem>
    </div>

    <div class="relative mb-16">
      <div
        class="absolute left-0 top-0 h-px w-8 bg-neutral-300 dark:bg-neutral-600"
      ></div>
      <h2
        class="mb-8 text-lg font-medium text-neutral-800 dark:text-neutral-200"
      >
        past work
      </h2>

      <div class="space-y-8">
        <ProjectItem>
          <div class="mb-1 flex items-center gap-2">
            <h3 class="font-medium text-neutral-800 dark:text-neutral-200">
              invoice tracker
            </h3>
            <a
              href="https://github.com/artyomkulimov/invoicetracker"
              aria-label="invoice tracker github repository"
              class="inline-flex min-h-6 items-center text-xs text-neutral-600 transition-colors hover:text-neutral-800 dark:text-neutral-400 dark:hover:text-neutral-200"
            >
              github
            </a>
          </div>
          <p
            class="text-sm leading-relaxed text-neutral-700 dark:text-neutral-300"
          >
            shipment and invoice tracker built for my dad: tracks GTD records,
            costs, multi-currency profit, edit history, admin views, and XLSX
            invoice exports. built with next.js app router, typescript, workos
            auth, drizzle orm, neon postgres, tailwind/shadcn ui.
          </p>
          <SkillTags
            skills={[
              'server actions',
              'database schema design',
              'currency calculations',
              'spreadsheet exports',
            ]}
          />
        </ProjectItem>

        <ProjectItem
          ariaLabel="open study lens showcase"
          href="/showcase/study-lens"
          showcase
        >
          <div class="mb-2 flex items-start justify-between gap-4">
            <div class="flex min-w-0 items-center gap-2">
              <h3
                class="font-medium text-neutral-800 transition-colors group-hover:text-neutral-950 dark:text-neutral-200 dark:group-hover:text-white"
              >
                study lens
              </h3>
              <!-- <p
                class="inline-flex min-h-6 shrink-0 items-center text-xs text-neutral-600 dark:text-neutral-400"
              >
                private prototype
              </p> -->
            </div>
            <span
              class="project-showcase-link mt-0.5 inline-flex shrink-0 items-center gap-1.5 font-mono text-[13px] leading-6 text-neutral-600 dark:text-neutral-400"
            >
              showcase
              <span aria-hidden="true" class="inline-flex" data-showcase-arrow>
                <ChevronRight class="h-4 w-4" />
              </span>
            </span>
          </div>
          <p
            class="text-sm leading-relaxed text-neutral-700 dark:text-neutral-300"
          >
            ai study companion that turns screenshots into guided feedback for
            reviewing problems, checking reasoning, and understanding mistakes.
            built with a python desktop hotkey agent, websocket relay, and
            next.js chat ui.
          </p>
          <SkillTags
            skills={[
              'desktop automation',
              'websocket architecture',
              'multimodal ai',
              'python + next.js integration',
            ]}
          />
        </ProjectItem>

        <ProjectItem
          ariaLabel="open tap.tm showcase"
          href="/showcase/taptm"
          showcase
        >
          <div class="mb-2 flex items-start justify-between gap-4">
            <div class="flex min-w-0 items-center gap-2">
              <h3
                class="font-medium text-neutral-800 transition-colors group-hover:text-neutral-950 dark:text-neutral-200 dark:group-hover:text-white"
              >
                tap.tm
              </h3>
            </div>
            <span
              class="project-showcase-link mt-0.5 inline-flex shrink-0 items-center gap-1.5 font-mono text-[13px] leading-6 text-neutral-600 dark:text-neutral-400"
            >
              showcase
              <span aria-hidden="true" class="inline-flex" data-showcase-arrow>
                <ChevronRight class="h-4 w-4" />
              </span>
            </span>
          </div>
          <p
            class="text-sm leading-relaxed text-neutral-700 dark:text-neutral-300"
          >
            real-estate mobile app built with expo router and react native, with
            kinde auth, property search/filtering, saved listings, image
            uploads, and a multi-step posting flow. built with three-language
            i18n for english, russian, and turkmen.
          </p>
          <SkillTags
            skills={[
              'expo router',
              'kinde auth',
              'i18n',
              'property flows',
            ]}
          />
        </ProjectItem>

        <ProjectItem>
          <div class="mb-1 flex items-center gap-2">
            <h3 class="font-medium text-neutral-800 dark:text-neutral-200">
              smac khalifa university app
            </h3>
            <a
              href="https://github.com/artyomkulimov/martab/"
              aria-label="smac khalifa university app github repository"
              class="inline-flex min-h-6 items-center text-xs text-neutral-600 transition-colors hover:text-neutral-800 dark:text-neutral-400 dark:hover:text-neutral-200"
            >
              github
            </a>
          </div>
          <p
            class="text-sm leading-relaxed text-neutral-700 dark:text-neutral-300"
          >
            hackathon waste-sorting app that used a fine-tuned google vision
            model trained on a hugging face dataset and hosted for inference on
            runpod. included i18n and tracked saved carbon emissions from
            correct disposal.
          </p>
          <SkillTags
            skills={[
              'computer vision',
              'hackathon build',
              'hugging face datasets',
              'runpod inference',
              'i18n',
            ]}
          />
        </ProjectItem>

        <ProjectItem
          ariaLabel="open burst control page"
          href="/burst-control"
          showcase
        >
          <div class="mb-2 flex items-start justify-between gap-4">
            <div class="flex min-w-0 items-center gap-2">
              <h3
                class="font-medium text-neutral-800 transition-colors group-hover:text-neutral-950 dark:text-neutral-200 dark:group-hover:text-white"
              >
                burst control
              </h3>
              <a
                href="https://github.com/artyomkulimov/burstcontrol"
                aria-label="burst control github repository"
                class="inline-flex min-h-6 items-center text-xs text-neutral-600 transition-colors hover:text-neutral-800 dark:text-neutral-400 dark:hover:text-neutral-200"
              >
                github
              </a>
            </div>
            <span
              class="project-showcase-link mt-0.5 inline-flex shrink-0 items-center gap-1.5 font-mono text-[13px] leading-6 text-neutral-600 dark:text-neutral-400"
            >
              showcase
              <span aria-hidden="true" class="inline-flex" data-showcase-arrow>
                <ChevronRight class="h-4 w-4" />
              </span>
            </span>
          </div>
          <p
            class="text-sm leading-relaxed text-neutral-700 dark:text-neutral-300"
          >
            native macOS app for the turtle beach burst ii air mouse, which has
            no official mac software. reverse-engineered the usb hid protocol to
            set dpi, polling rate, debounce, and battery readout. built with
            swift and swiftui, signed and notarized.
          </p>
          <SkillTags
            skills={[
              'swift',
              'usb hid',
              'reverse engineering',
              'macos notarization',
            ]}
          />
        </ProjectItem>

        <ProjectItem>
          <h3 class="mb-1 font-medium text-neutral-800 dark:text-neutral-200">
            self-hosted linux homelab
          </h3>
          <p
            class="text-sm leading-relaxed text-neutral-700 dark:text-neutral-300"
          >
            linux server running a 16 TB siacoin node and private media stack
            with jellyfin, radarr, sonarr, prowlarr, and transmission. hands-on
            with storage, services, networking, ssh, tailscale vpn, and keeping
            self-hosted apps running.
          </p>
          <SkillTags
            skills={[
              'linux sysop',
              'docker',
              'ssh',
              'networking',
            ]}
          />
        </ProjectItem>
      </div>

      <p
        class="mb-6 mt-12 font-mono text-[13px] text-neutral-500 dark:text-neutral-400"
      >
        earlier
      </p>
      <div class="space-y-6">
        <div>
          <h3 class="mb-1 font-medium text-neutral-800 dark:text-neutral-200">
            nebuladevs
          </h3>
          <p
            class="text-sm leading-relaxed text-neutral-700 dark:text-neutral-300"
          >
            experimented co-founding <strong>nebuladevs</strong>, built client
            sites, learned real dev + delivery.
          </p>
        </div>

        <div>
          <h3 class="mb-1 font-medium text-neutral-800 dark:text-neutral-200">
            examvault
          </h3>
          <p
            class="text-sm leading-relaxed text-neutral-700 dark:text-neutral-300"
          >
            then co-founded <strong>examvault</strong>, where ai and education
            meet to help students learn smarter.
          </p>
        </div>
      </div>
    </div>

    <div class="relative">
      <div
        class="absolute left-0 top-0 h-px w-8 bg-neutral-300 dark:bg-neutral-600"
      ></div>
      <h2
        class="mb-8 text-lg font-medium text-neutral-800 dark:text-neutral-200"
      >
        art
      </h2>

      <ProjectItem
        ariaLabel="open art.artyomkulimov.com"
        href="https://art.artyomkulimov.com"
        showcase
      >
        <div class="mb-2 flex items-start justify-between gap-4">
          <h3
            class="font-medium text-neutral-800 transition-colors group-hover:text-neutral-950 dark:text-neutral-200 dark:group-hover:text-white"
          >
            paintings
          </h3>
          <span
            class="project-showcase-link mt-0.5 inline-flex shrink-0 items-center gap-1.5 font-mono text-[13px] leading-6 text-neutral-600 dark:text-neutral-400"
          >
            art.artyomkulimov.com
            <span aria-hidden="true" class="inline-flex" data-showcase-arrow>
              <ArrowUpRight class="h-4 w-4" />
            </span>
          </span>
        </div>
        <p
          class="text-sm leading-relaxed text-neutral-700 dark:text-neutral-300"
        >
          a small collection of paintings i find beautiful, hung on a wall drawn
          like an architectural elevation.
        </p>
        <div class="art-strip mt-4 flex gap-3">
          {paintings.map((p) => (
            <Image
              alt={p.alt}
              class="h-20 w-auto min-w-0 flex-[var(--r)] object-cover sm:h-24"
              src={p.src}
              style={`--r: ${(p.src.width / p.src.height).toFixed(3)}`}
              widths={[240, 480]}
              sizes="(min-width: 640px) 220px, 30vw"
            />
          ))}
        </div>
      </ProjectItem>
    </div>
  </section>
</BaseLayout>
