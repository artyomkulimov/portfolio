---
import { Image } from "astro:assets";
import babylon from "../assets/art/fall-of-babylon.jpg";
import pandemonium from "../assets/art/pandemonium.jpg";
import wetMoon from "../assets/art/wet-moon-putney-road.jpg";
import skyline from "../assets/previews/openline-skyline.webp";
import EmailCopy from "../components/EmailCopy.astro";
import IndexRow from "../components/IndexRow.astro";
import OpenlineLockup from "../components/OpenlineLockup.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    name: "burst control",
    what: "mac driver for an air mouse",
    meta: "swift",
    href: "/burst-control",
  },
  {
    name: "noon automation",
    what: "runs a noon shop by chat",
    meta: "codex",
    href: "https://github.com/artyomkulimov/noon-automation",
  },
  {
    name: "study lens",
    what: "screenshot in, feedback out",
    meta: "python",
    href: "/showcase/study-lens",
  },
  {
    name: "tap.tm",
    what: "real-estate app in three languages",
    meta: "expo",
    href: "/showcase/taptm",
  },
  {
    name: "smac",
    what: "waste sorting with a vision model",
    meta: "cv",
    href: "https://github.com/artyomkulimov/martab/",
  },
  {
    name: "homelab",
    what: "16 tb sia node, media stack",
    meta: "linux",
    href: "https://github.com/artyomkulimov",
  },
  {
    name: "nebuladevs",
    what: "co-founded, client sites",
    meta: "before",
    href: "https://nebuladevs.com/",
  },
  {
    name: "examvault",
    what: "co-founded, ai for studying",
    meta: "before",
    href: "https://examvault.app/",
  },
] as const;

const paintings = [
  { src: pandemonium, alt: "pandemonium, john martin, 1841" },
  { src: babylon, alt: "the fall of babylon, john martin, 1819" },
  {
    src: wetMoon,
    alt: "a wet moon, putney road, john atkinson grimshaw, 1886",
  },
];
---

<BaseLayout variant="home">
  <div class="page">
    <header class="top">
      <h1 class="me">artyom kulimov</h1>
      <nav aria-label="elsewhere" class="links">
        <a href="https://github.com/artyomkulimov">github</a>
        <a href="https://x.com/artyomkulimov">x</a>
        <a href="https://www.linkedin.com/in/artyom-kulimov-7a5032265/">
          linkedin
        </a>
        <EmailCopy class="email" />
      </nav>
    </header>

    <main>
      <section aria-labelledby="about">
        <h2 id="about">ABOUT</h2>
        <p class="dim">
          <span class="ink">developer.</span>
          i'm building openline. before that i co-founded nebuladevs and
          examvault, and shipped the things below.
        </p>
      </section>

      <section aria-labelledby="now">
        <h2 id="now">NOW</h2>
        <a class="openline" href="https://openline.sh">
          <Image
            alt="openline's pixel-art dubai skyline at night"
            class="skyline"
            loading="eager"
            src={skyline}
          />
          <span class="overlay">
            <span class="openline-head"> <OpenlineLockup /> </span>
            <span class="quote">
              "ai made individuals faster and teams slower."
            </span>
            <span class="blurb">
              openline lets everyone's agent reach everyone else's, so nothing
              gets copied and pasted between them.
            </span>
          </span>
        </a>
        <p class="pills">
          <a class="pill" href="https://openline.sh">openline.sh ↗</a>
          <a class="pill" href="https://openline.sh/manifesto">
            read the manifesto ↗
          </a>
        </p>
      </section>

      <section aria-labelledby="past">
        <h2 id="past">PAST WORK</h2>
        <div class="rows">
          {projects.map((p) => <IndexRow {...p} />)}
        </div>
      </section>

      <section aria-labelledby="art">
        <h2 id="art">ART</h2>
        <a class="art" href="https://art.artyomkulimov.com">
          <span class="strip">
            {paintings.map((p) => (
                <Image
                  alt={p.alt}
                  src={p.src}
                  style={`--r: ${(p.src.width / p.src.height).toFixed(3)}`}
                  widths={[240, 480]}
                  sizes="(min-width: 640px) 200px, 30vw"
                />
              ))}
          </span>
          <span class="art-foot">
            <span>art.artyomkulimov.com</span>
            <span aria-hidden="true">↗</span>
          </span>
        </a>
      </section>
    </main>

    <footer class="foot">
      © {new Date().getFullYear()} artyom kulimov ·
      <a class="pill" href="https://github.com/artyomkulimov/portfolio">
        source
      </a>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  /* The home page is always the dark openline look, whatever palette or
               theme the showcase pages remember. */
  html:has(> body.home) {
    color-scheme: dark;
    background: #0a0a0a;
  }

  body.home {
    --home-ground: #0a0a0a;
    --home-ink: #fafafa;
    --home-muted: #a1a1a1;
    --home-subtle: #737373;
    --home-border: #262626;
    --home-card: #171717;
    --home-link: #e59295;
    --home-link-ground: #250105;
    --home-success: #54bd6f;
    margin: 0;
    font-family: "Geist Mono Variable", ui-monospace, monospace;
    font-size: 15px;
    line-height: 26px;
    color: var(--home-ink);
    background: var(--home-ground);
  }

  body.home ::selection {
    color: var(--home-ink);
    background: #8c1d2f;
  }
</style>

<style>
  .page {
    width: min(600px, 100% - 2.5rem);
    padding: 4.5rem 0 5rem;
    margin: 0 auto;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: baseline;
    justify-content: space-between;
  }

  .me {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .links {
    display: flex;
    gap: 1rem;
  }

  .links a,
  .links :global(.email) {
    padding: 0;
    font: inherit;
    color: var(--home-muted);
    text-decoration: none;
    cursor: pointer;
    background: none;
    border: 0;
    transition: color 0.15s;
  }

  .links a:hover,
  .links :global(.email:hover) {
    color: var(--home-ink);
  }

  section {
    margin-top: 4rem;
  }

  section:first-child {
    margin-top: 3rem;
  }

  section > * + * {
    margin-top: 1.25rem;
  }

  h2 {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  p {
    margin: 0;
  }

  section > p + p {
    margin-top: 0.75rem;
  }

  .dim {
    color: var(--home-muted);
  }

  .ink {
    color: var(--home-ink);
  }

  .openline {
    position: relative;
    display: block;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }

  .openline :global(.skyline) {
    display: block;
    width: 100%;
    height: 400px;
    object-fit: cover;
    object-position: center 60%;
    image-rendering: pixelated;
    transition: filter 0.2s;
  }

  /* Logo and text sit in the night sky; the fade only darkens the top, so
         the cloud glow at the bottom stays. */
  .overlay {
    position: absolute;
    inset: 0 0 auto;
    display: block;
    padding: 1.375rem 1.5rem 4rem;
    background: linear-gradient(
      to bottom,
      rgb(10 10 10 / 70%),
      rgb(10 10 10 / 45%) 60%,
      rgb(10 10 10 / 0%)
    );
  }

  .openline-head {
    display: flex;
    align-items: center;
  }

  .quote {
    display: block;
    margin-top: 1rem;
    color: var(--home-ink);
  }

  .blurb {
    display: block;
    max-width: 30rem;
    margin-top: 0.25rem;
    color: #d4d4d4;
  }

  .openline:hover :global(.skyline) {
    filter: brightness(1.12);
  }

  .openline:hover :global(.word) {
    color: var(--home-link);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .pill {
    padding: 1px 3px;
    color: var(--home-link);
    text-decoration: none;
    background: var(--home-link-ground);
    border-radius: 4px;
    transition: color 0.15s;
  }

  .pill:hover {
    color: var(--home-ink);
  }

  .art {
    display: block;
    color: var(--home-muted);
    text-decoration: none;
  }

  .strip {
    display: flex;
    gap: 0.75rem;
    height: 6rem;
  }

  .strip :global(img) {
    flex: var(--r);
    min-width: 0;
    height: 100%;
    object-fit: cover;
    transition: filter 0.2s;
  }

  .art:hover .strip :global(img) {
    filter: brightness(1.15);
  }

  .art-foot {
    display: flex;
    justify-content: space-between;
    margin-top: 0.75rem;
    transition: color 0.15s;
  }

  .art:hover .art-foot {
    color: var(--home-link);
  }

  .foot {
    margin-top: 4.5rem;
    color: var(--home-subtle);
  }

  @media (max-width: 40rem) {
    .page {
      padding-top: 2.5rem;
    }

    .openline :global(.skyline) {
      height: 460px;
      object-position: 40% 80%;
    }

    .overlay {
      padding: 1.125rem 1.125rem 3rem;
    }
  }
</style>
