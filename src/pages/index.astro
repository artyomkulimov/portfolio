---
import { Image } from "astro:assets";
import babylon from "../assets/art/fall-of-babylon.jpg";
import pandemonium from "../assets/art/pandemonium.jpg";
import wetMoon from "../assets/art/wet-moon-putney-road.jpg";
import skyline from "../assets/previews/openline-skyline.webp";
import IndexRow from "../components/IndexRow.astro";
import OpenlineLockup from "../components/OpenlineLockup.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    name: "burst control",
    what: "mac driver for an air mouse",
    meta: "swift",
    href: "/burst-control",
  },
  {
    name: "noon automation",
    what: "runs a noon shop by chat",
    meta: "codex",
    href: "https://github.com/artyomkulimov/noon-automation",
  },
  {
    name: "study lens",
    what: "screenshot in, feedback out",
    meta: "python",
    href: "/showcase/study-lens",
  },
  {
    name: "tap.tm",
    what: "real-estate app in three languages",
    meta: "expo",
    href: "/showcase/taptm",
  },
  {
    name: "smac",
    what: "waste sorting with a vision model",
    meta: "cv",
    href: "https://github.com/artyomkulimov/martab/",
  },
  {
    name: "homelab",
    what: "16 tb sia node, media stack",
    meta: "linux",
    href: "https://github.com/artyomkulimov",
  },
  {
    name: "nebuladevs",
    what: "co-founded, client sites",
    meta: "before",
    href: "https://nebuladevs.com/",
  },
  {
    name: "examvault",
    what: "co-founded, ai for studying",
    meta: "before",
    href: "https://examvault.app/",
  },
] as const;

const paintings = [
  { src: pandemonium, alt: "pandemonium, john martin, 1841" },
  { src: babylon, alt: "the fall of babylon, john martin, 1819" },
  {
    src: wetMoon,
    alt: "a wet moon, putney road, john atkinson grimshaw, 1886",
  },
];
---

<BaseLayout>
  <section aria-labelledby="about">
    <h2 class="hidden" id="about">about</h2>
    <p class="dim intro">
      <span class="ink">developer.</span>
      working on connecting agents together.
    </p>
  </section>

  <section aria-labelledby="now">
    <h2 class="hidden" id="now">now</h2>
    <a class="openline" href="https://openline.sh">
      <Image
        alt="openline's pixel-art dubai skyline at night"
        class="skyline"
        loading="eager"
        src={skyline}
      />
      <span class="overlay">
        <span class="openline-head"> <OpenlineLockup /> </span>
        <span class="quote">
          "ai made individuals faster and teams slower."
        </span>
        <span class="blurb">
          openline lets everyone's agent reach everyone else's, so nothing gets
          copied and pasted between them.
        </span>
      </span>
    </a>
    <p class="pills">
      <a class="pill" href="https://openline.sh">openline.sh ↗</a>
      <a class="pill" href="https://openline.sh/manifesto">
        read the manifesto ↗
      </a>
    </p>
  </section>

  <section aria-labelledby="past">
    <h2 class="hidden" id="past">past work</h2>
    <div class="rows">
      {projects.map((p) => <IndexRow {...p} />)}
    </div>
  </section>

  <section aria-labelledby="art">
    <h2 class="hidden" id="art">art</h2>
    <a class="art" href="https://art.artyomkulimov.com">
      <span class="strip">
        {paintings.map((p) => (
            <Image
              alt={p.alt}
              src={p.src}
              style={`--r: ${(p.src.width / p.src.height).toFixed(3)}`}
              widths={[240, 480]}
              sizes="(min-width: 640px) 200px, 30vw"
            />
          ))}
      </span>
      <span class="art-foot">
        <span>art.artyomkulimov.com</span>
        <span aria-hidden="true">↗</span>
      </span>
    </a>
  </section>
</BaseLayout>

<style>
  .intro {
    font-size: 20px;
    line-height: 32px;
  }

  .openline {
    position: relative;
    display: block;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }

  .openline :global(.skyline) {
    display: block;
    width: 100%;
    height: 400px;
    object-fit: cover;
    object-position: center 60%;
    image-rendering: pixelated;
    transition: filter 0.2s;
  }

  /* Logo and text sit in the night sky; the fade only darkens the top, so
         the cloud glow at the bottom stays. */
  .overlay {
    position: absolute;
    inset: 0 0 auto;
    display: block;
    padding: 1.375rem 1.5rem 4rem;
    background: linear-gradient(
      to bottom,
      rgb(10 10 10 / 70%),
      rgb(10 10 10 / 45%) 60%,
      rgb(10 10 10 / 0%)
    );
  }

  .openline-head {
    display: flex;
    align-items: center;
  }

  .quote {
    display: block;
    margin-top: 1rem;
    color: var(--ink);
  }

  .blurb {
    display: block;
    max-width: 30rem;
    margin-top: 0.25rem;
    color: var(--soft);
  }

  .openline:hover :global(.skyline) {
    filter: brightness(1.12);
  }

  .openline:hover :global(.word) {
    color: var(--link);
  }

  .art {
    display: block;
    color: var(--muted);
    text-decoration: none;
  }

  .strip {
    display: flex;
    gap: 0.75rem;
    height: 6rem;
  }

  .strip :global(img) {
    flex: var(--r);
    min-width: 0;
    height: 100%;
    object-fit: cover;
    transition: filter 0.2s;
  }

  .art:hover .strip :global(img) {
    filter: brightness(1.15);
  }

  .art-foot {
    display: flex;
    justify-content: space-between;
    margin-top: 0.75rem;
    transition: color 0.15s;
  }

  .art:hover .art-foot {
    color: var(--link);
  }

  @media (max-width: 40rem) {
    .openline :global(.skyline) {
      height: 460px;
      object-position: 40% 80%;
    }

    .overlay {
      padding: 1.125rem 1.125rem 3rem;
    }
  }
</style>
