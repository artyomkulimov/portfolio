---
import { Image } from "astro:assets";
import studyLensContent from "../../assets/study-lens/content.png";
import BaseLayout from "../../layouts/BaseLayout.astro";

const flow = [
  {
    label: "hotkey capture",
    body: "Python desktop agent grabs the current problem or worksheet state.",
  },
  {
    label: "live relay",
    body: "A WebSocket bridge moves the screenshot into the web UI without a manual upload loop.",
  },
  {
    label: "ai review",
    body: "The model checks the work, spots the weak step, and explains the correction.",
  },
  {
    label: "feedback ui",
    body: "Next.js chat surface keeps the answer readable, focused, and easy to revise from.",
  },
];

const details = [
  "desktop automation",
  "websocket relay",
  "multimodal prompting",
  "python agent",
  "next.js chat ui",
  "private prototype",
];
---

<BaseLayout
  title="study lens showcase"
  description="Private AI study assistant showcase"
>
  <header class="hero">
    <p class="subtle">ai study workflow</p>
    <h1 class="title">study lens</h1>
    <p class="dim">
      A screenshot-based study companion for reviewing solved problems, checking
      reasoning, and turning mistakes into focused feedback.
    </p>
    <p class="subtle">{details.join(" · ")}</p>
    <figure>
      <Image
        alt="Study Lens showing a question paper screenshot and a model answer"
        class="shot"
        loading="eager"
        sizes="(min-width: 640px) 600px, 92vw"
        src={studyLensContent}
        widths={[600, 900, 1200]}
      />
      <figcaption>one capture, one readable answer.</figcaption>
    </figure>
  </header>

  <section aria-labelledby="how">
    <h2 id="how">how it works</h2>
    <ol class="ruled flow">
      {flow.map((step, index) => (
        <li>
          <span class="n">{String(index + 1).padStart(2, "0")}</span>
          <span>
            <span class="ink">{step.label}</span>
            <span class="dim">{step.body}</span>
          </span>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .hero > * + * {
    margin-top: 1.25rem;
  }

  .hero > .title {
    margin-top: 0.5rem;
  }

  .hero figure {
    margin-top: 2rem;
  }

  .flow {
    padding: 0;
    list-style: none;
  }

  .flow li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
  }

  .flow li > span:last-child > span {
    display: block;
  }

  .n {
    color: var(--subtle);
  }
</style>
